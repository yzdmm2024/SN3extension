<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>SN3延伸板</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>OCR 识别（本地 Apple Vision，离线免费）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用中文 OCR</string>
			<key>key</key>
			<string>OCR_Enabled</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>识别语言（逗号分隔）</string>
			<key>placeholder</key>
			<string>zh-Hans,zh-Hant,en-US</string>
			<key>key</key>
			<string>OCR_Languages</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
			<key>default</key>
			<string>zh-Hans,zh-Hant,en-US</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>翻译（需自备百度翻译 AppID / 密钥，fanyi-api.baidu.com）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用翻译</string>
			<key>key</key>
			<string>Translate_Enabled</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>AppID</string>
			<key>key</key>
			<string>Translate_APIAppID</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
		</dict>
		<dict>
				<key>cell</key>
				<string>PSEditTextCell</string>
				<key>label</key>
				<string>密钥</string>
				<key>isSecure</key>
				<true/>
				<key>key</key>
				<string>Translate_APIKey</string>
				<key>defaults</key>
				<string>com.axs.snapper3zhext</string>
			</dict>
			<dict>
				<key>cell</key>
				<string>PSEditTextCell</string>
				<key>label</key>
				<string>目标语言 (zh/en/jp/kor/fra/spa/ru/de/it/pt/th/vie/ara)</string>
				<key>placeholder</key>
				<string>zh</string>
				<key>key</key>
				<string>Translate_TargetLang</string>
				<key>defaults</key>
				<string>com.axs.snapper3zhext</string>
				<key>default</key>
				<string>zh</string>
			</dict>

		<dict>
				<key>cell</key>
				<string>PSGroupCell</string>
				<key>label</key>
				<string>长截图（可调拼接参数）</string>
			</dict>
			<dict>
				<key>cell</key>
				<string>PSSwitchCell</string>
				<key>label</key>
				<string>启用长截图</string>
				<key>key</key>
				<string>LongShot_Enabled</string>
				<key>defaults</key>
				<string>com.axs.snapper3zhext</string>
				<key>default</key>
				<true/>
			</dict>
			<dict>
				<key>cell</key>
				<string>PSEditTextCell</string>
				<key>label</key>
				<string>帧间重叠比例 (0~0.3，画面抖动时调大)</string>
				<key>placeholder</key>
				<string>0</string>
				<key>key</key>
				<string>LongShot_Overlap</string>
				<key>defaults</key>
				<string>com.axs.snapper3zhext</string>
				<key>default</key>
				<string>0</string>
			</dict>
			<dict>
				<key>cell</key>
				<string>PSEditTextCell</string>
				<key>label</key>
				<string>最大拼接高度(px，防超长卡死)</string>
				<key>placeholder</key>
				<string>6000</string>
				<key>key</key>
				<string>LongShot_MaxHeight</string>
				<key>defaults</key>
				<string>com.axs.snapper3zhext</string>
				<key>default</key>
				<string>6000</string>
			</dict>
			<dict>
				<key>cell</key>
				<string>PSEditTextCell</string>
				<key>label</key>
				<string>每帧等待秒数 (0.02~0.15，内容加载慢时调大)</string>
				<key>placeholder</key>
				<string>0.03</string>
				<key>key</key>
				<string>LongShot_Interval</string>
				<key>defaults</key>
				<string>com.axs.snapper3zhext</string>
				<key>default</key>
				<string>0.03</string>
			</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>问 AI（OpenAI 兼容接口，如 DeepSeek / OpenAI / 自建）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用问 AI</string>
			<key>key</key>
			<string>AskAI_Enabled</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>接口地址</string>
			<key>placeholder</key>
			<string>https://api.deepseek.com/v1</string>
			<key>key</key>
			<string>AskAI_BaseURL</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
			<key>default</key>
			<string>https://api.deepseek.com/v1</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>API Key</string>
			<key>isSecure</key>
			<true/>
			<key>key</key>
			<string>AskAI_APIKey</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>模型</string>
			<key>placeholder</key>
			<string>deepseek-chat</string>
			<key>key</key>
			<string>AskAI_Model</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
			<key>default</key>
			<string>deepseek-chat</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>提问提示词</string>
			<key>key</key>
			<string>AskAI_Prompt</string>
			<key>defaults</key>
			<string>com.axs.snapper3zhext</string>
			<key>default</key>
			<string>请总结图片中的文字内容</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>手动修改可在 /var/mobile/Library/Preferences/com.axs.snapper3zhext.plist 中编辑，修改后需注销。安装本插件后请先重启桌面（respring）。</string>
		</dict>
	</array>
</dict>
</plist>